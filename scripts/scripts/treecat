#!/usr/bin/env bash

set -euo pipefail

show_structure=false

# --- Parse arguments ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--structure)
      show_structure=true
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      echo "Usage: $(basename "$0") [-s|--structure] <directory>" >&2
      exit 1
      ;;
    *)
      dir="$1"
      shift
      ;;
  esac
done

# --- Validate directory ---
if [[ -z "${dir:-}" ]]; then
  echo "Usage: $(basename "$0") [-s|--structure] <directory>" >&2
  exit 1
fi

if [[ ! -d "$dir" ]]; then
  echo "Error: '$dir' is not a directory" >&2
  exit 1
fi

# --- Detect clipboard tool ---
if command -v wl-copy &>/dev/null; then
  CLIP_CMD="wl-copy"
elif command -v clipman &>/dev/null; then
  CLIP_CMD="clipman store"
elif command -v xclip &>/dev/null; then
  CLIP_CMD="xclip -selection clipboard"
elif command -v xsel &>/dev/null; then
  CLIP_CMD="xsel --clipboard --input"
else
  echo "Error: no clipboard tool found (install wl-clipboard, clipman, xclip, or xsel)." >&2
  exit 1
fi

# --- Generate output ---
{
  if $show_structure; then
    if command -v eza &>/dev/null; then
      echo "=== DIRECTORY STRUCTURE: $dir ==="
      eza --tree --icons=always "$dir"
      echo
      echo "=== FILE CONTENTS ==="
    else
      echo "Warning: eza not found, skipping structure listing." >&2
    fi
  fi

  find "$dir" -type f -print0 | sort -z | while IFS= read -r -d '' f; do
    echo "=== START $f ==="
    cat "$f"
    echo "=== END $f ==="
    echo
  done
} | eval "$CLIP_CMD"

echo "✅ Copied contents of '$dir' to clipboard using: $CLIP_CMD"
