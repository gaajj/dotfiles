[user]
	name = Daan Tas
	email = daan@gaaj.dev
	signingkey = ~/.ssh/id_ed25519.pub

[core]
	editor = vim

[init]
	defaultBranch = main

[pull]
	rebase = true

[commit]
	gpgsign = true

[gpg]
	format = ssh

[push]
	autoSetupRemote = true

[alias]
	s = status -sb
  o = checkout
  b = branch
  l = log --graph --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''%C(white)%s%C(reset) %C(dim white)- %an%C(reset)%n''' --all
