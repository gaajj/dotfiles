[user]
	name = Daan Tas
	email = daan@gaaj.dev
	signingkey = ~/.ssh/id_ed25519.pub

[core]
	editor = vim

[init]
	defaultBranch = main

[pull]
	rebase = true

[commit]
	gpgsign = true

[gpg]
	format = ssh

[push]
	autoSetupRemote = true

[alias]
	s = status -sb
  o = checkout
  b = branch
	l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %<(50,trunc)%s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all
